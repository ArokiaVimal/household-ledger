rules_version = '2';

// Household-level access. Membership docs and invites are written only by server code
// (Admin SDK bypasses rules), so clients can never grant themselves access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(hid) { return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid); }
    function isMember(hid) { return signedIn() && exists(memberPath(hid)); }
    // A link space (one per linked Friends & Family pair) only ever holds server-written, redacted copies: clients may read, never write.
    function isLink(hid) { return get(/databases/$(database)/documents/households/$(hid)).data.get('kind', '') == 'link'; }
    function canWrite(hid) { return isMember(hid) && !isLink(hid); }

    // ---- data validation helpers (money is integer paise, never floats) ----
    function isPaise(v) { return v is int && v > 0; }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validRecord(d) {
      return d.keys().hasOnly(['id','date','postedDate','merchant','originalDescription','amountPaise','currency','accountId','categoryId','kind','payerId','shared','split','excluded','status','importSource','referenceId','notes','duplicateOf','receiptId','fundedBy','recurringId','suggested','sharedWithPartner','shareNote','schemaVersion'])
        && d.keys().hasAll(['date','merchant','originalDescription','amountPaise','currency','accountId','categoryId','kind','payerId','shared','split','excluded','status','importSource'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.merchant, 120)
        && d.originalDescription is string && d.originalDescription.size() <= 500
        && isPaise(d.amountPaise)
        && d.currency == 'INR'
        && str(d.accountId, 128) && str(d.categoryId, 128) && str(d.payerId, 128)
        && d.kind in ['purchase','refund','income','transfer','cc_payment','fee']
        && d.status in ['unreviewed','reviewed']
        && d.shared is bool && d.excluded is bool
        && d.split is map && d.split.mode in ['personal','equal','percent','custom']
        && str(d.importSource, 200);
    }
    // Imported (bank-sourced) fields never change after creation; manual entries are the user's own.
    function rawUnchanged(o, n) {
      return o.importSource == 'Manual entry'
        || (o.date == n.date && o.amountPaise == n.amountPaise && o.originalDescription == n.originalDescription
            && o.currency == n.currency && o.accountId == n.accountId && o.importSource == n.importSource
            && o.get('referenceId', null) == n.get('referenceId', null) && o.get('postedDate', null) == n.get('postedDate', null));
    }
    function validSettlement(d) {
      return d.keys().hasOnly(['id','date','fromId','toId','amountPaise','note','voided'])
        && d.keys().hasAll(['date','fromId','toId','amountPaise'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.fromId, 128) && str(d.toId, 128) && d.fromId != d.toId
        && isPaise(d.amountPaise)
        && d.get('voided', false) == false;
    }
    function validAudit(d) {
      return d.keys().hasOnly(['id','at','actorId','action','entity','entityId','summary'])
        && d.keys().hasAll(['at','actorId','action','entity','entityId','summary'])
        && d.actorId == request.auth.uid
        && str(d.summary, 500);
    }
    function smallDoc(d) { return d.keys().size() <= 20; }

    // ---- profile: the owner may read their own; writes go through the server ----
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- invites: server only (they bind a hashed code to an email) ----
    match /invites/{hash} {
      allow read, write: if false;
    }

    // Account links between a contact owner and a linked account: server only.
    match /contactLinks/{key} {
      allow read, write: if false;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      match /records/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && validRecord(request.resource.data);
        allow update: if canWrite(hid) && validRecord(request.resource.data) && rawUnchanged(resource.data, request.resource.data);
        allow delete: if false; // never destroy financial records; exclude them instead
      }

      // Immutable copy of what the bank said.
      match /rawTransactions/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && smallDoc(request.resource.data);
        allow update, delete: if false;
      }

      // Statement upload history is written by the server only.
      match /importBatches/{id} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      // What the import has learned about merchants: written by the server only.
      match /merchantMemory/{id} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      match /settlements/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && validSettlement(request.resource.data);
        // Corrections void the old entry (and add a new one); amounts never change in place.
        allow update: if canWrite(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided'])
          && request.resource.data.voided == true;
        allow delete: if false;
      }

      // Couple space only: the redacted copies partners share. Written by server code (Admin SDK); members can only read.
      match /sharedExpenses/{id} {
        allow read: if isMember(hid);
        allow write: if false;
      }

      match /auditEvents/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && validAudit(request.resource.data);
        allow update, delete: if false;
      }

      // Configuration the household edits together.
      match /categories/{id} { allow read: if isMember(hid); allow create, update: if canWrite(hid) && smallDoc(request.resource.data); allow delete: if canWrite(hid); }
      match /recurring/{id} { allow read: if isMember(hid); allow create, update: if canWrite(hid) && smallDoc(request.resource.data); allow delete: if canWrite(hid); }
      // Card bills are written by the server only.
      match /cardBills/{id} { allow read: if isMember(hid); allow write: if false; }
      match /voucherBrands/{id} { allow read: if isMember(hid); allow write: if false; }
      // Payment groups (per-profile lenses on spending) are written by the server only.
      match /paymentGroups/{id} { allow read: if isMember(hid); allow write: if false; }
      match /receipts/{id} { allow read: if isMember(hid); allow create, update: if canWrite(hid) && smallDoc(request.resource.data); allow delete: if canWrite(hid); }
      // Participants and accounts are referenced by history, so they are archived, not deleted.
      match /participants/{id} { allow read: if isMember(hid); allow create, update: if canWrite(hid) && smallDoc(request.resource.data); allow delete: if false; }
      match /accounts/{id} { allow read: if isMember(hid); allow create, update: if canWrite(hid) && smallDoc(request.resource.data); allow delete: if false; }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
